data/backups/*/
debug/

# Transient classification batch coordination files
artifacts/phase5/**/.operator.lock
artifacts/phase5/**/*.tmp

# Node / Web
node_modules/
.pnpm-store/
.turbo/
web/test-results/
web/playwright-report/
# Keep generated visual captures local; selected acceptance evidence is tracked explicitly.
docs/stitch-review/*.png
# Pre-built frontends tracked for zero-node portability
!web/apps/student/dist/**
!web/apps/curator/dist/**


# OS and IDE
