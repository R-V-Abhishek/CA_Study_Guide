{
  "$defs": {
    "LabelEvidence": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "support": {
          "title": "Support",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "support"
      ],
      "title": "LabelEvidence",
      "type": "object"
    },
    "MappingOutput": {
      "additionalProperties": false,
      "properties": {
        "part_id": {
          "title": "Part Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "matched",
            "needs_review",
            "none_fits"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "primary_node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Primary Node Id"
        },
        "secondary_node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Secondary Node Ids",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/LabelEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence"
        },
        "bucket": {
          "anyOf": [
            {
              "enum": [
                "A",
                "B",
                "C",
                "D"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bucket"
        }
      },
      "required": [
        "part_id",
        "outcome",
        "primary_node_id",
        "secondary_node_ids",
        "evidence",
        "note",
        "confidence",
        "bucket"
      ],
      "title": "MappingOutput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "question_id": {
      "title": "Question Id",
      "type": "string"
    },
    "input_hash": {
      "title": "Input Hash",
      "type": "string"
    },
    "mappings": {
      "items": {
        "$ref": "#/$defs/MappingOutput"
      },
      "title": "Mappings",
      "type": "array"
    }
  },
  "required": [
    "question_id",
    "input_hash",
    "mappings"
  ],
  "title": "RootOutput",
  "type": "object"
}