{
  "name": "ca-final-study-companion-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "node scripts/build.mjs",
    "lint": "turbo lint",
    "type-check": "turbo type-check && pnpm type-check:browser",
    "type-check:browser": "pnpm --filter student exec tsc -p ../../tsconfig.browser.json",
    "test:browser": "playwright test",
    "test:ui": "node --test tests/ui/*.test.cjs",
    "check:dist": "node scripts/check-dist.mjs",
    "format": "prettier --write \"{apps,packages}/*/src/**/*.{ts,tsx}\" \"tests/**/*.ts\" playwright.config.ts",
    "format:check": "prettier --check \"{apps,packages}/*/src/**/*.{ts,tsx}\" \"tests/**/*.ts\" playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "3.9.10",
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@12.6.0"
}
