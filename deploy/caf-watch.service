[Unit]
Description=CA Final Companion health watch
Requires=docker.service
After=docker.service caf.service
ConditionPathExists=/srv/caf/current-compose.json

[Service]
Type=oneshot
User=cafdeploy
Group=cafdeploy
SupplementaryGroups=docker
ExecStart=/opt/caf/repo/deploy/caf-host watch
TimeoutStartSec=300
