# Template only. The real file belongs at /etc/caf/compose.env, mode 0600.
# Use distinct randomly generated hexadecimal database passwords (32+ bytes each).
# Hex avoids special-character escaping in the assembled database URLs.
# CAF_IMAGE must identify a loaded release image; production must not use latest.
CAF_IMAGE=
CAF_REVISION=
CAF_PLATFORM=linux/amd64
PG_SUPERUSER_PASSWORD=
PG_APP_PASSWORD=
PG_IDENTITY_PASSWORD=
PG_CURATOR_PASSWORD=
PG_OPERATIONS_PASSWORD=
PG_PIPELINE_PASSWORD=
PG_BACKUP_PASSWORD=
# No trailing slash on the application URL; Auth0 issuer normally ends with /.
AUTH_PUBLIC_BASE_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
