# PostgreSQL Superuser & Port
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=postgres_dev_password
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DATABASE=caf

# Main connection URL (for migrations and administrative runs)
DATABASE_URL=postgresql+psycopg://postgres:postgres_dev_password@127.0.0.1:5433/caf

# Role-specific passwords (used when caf db grants creates roles)
PG_PIPELINE_PASSWORD=pipeline_dev_password
PG_CURATOR_PASSWORD=curator_dev_password
PG_APP_PASSWORD=app_dev_password

# Google Gemini API Key (Billing-enabled GCP project required for Tier credits)
GEMINI_API_KEY=your_gemini_api_key_here

# Independent student-review classification exports; free endpoints only.
OPENROUTER_API_KEY=

# App settings
CAF_ENV=development
CAF_DATA_DIR=./data

# Phase 2: caf db configure-connections fills missing passwords and URLs.
PG_IDENTITY_PASSWORD=
PG_OPERATIONS_PASSWORD=
PG_BACKUP_PASSWORD=
STUDENT_DATABASE_URL=
IDENTITY_DATABASE_URL=
CURATION_DATABASE_URL=
OPERATIONS_DATABASE_URL=
PIPELINE_DATABASE_URL=
BACKUP_DATABASE_URL=

# Auth0 Regular Web Application. Issuer must match discovery exactly (trailing /).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8788/auth/callback
AUTH_PUBLIC_BASE_URL=http://127.0.0.1:8788
AUTH_LOCAL_DEVELOPMENT=true
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:8788,http://localhost:5173,http://localhost:5174
# Production: CAF_ENV=production, AUTH_LOCAL_DEVELOPMENT=false; use HTTPS URLs.
# Migration credentials belong only in the administration environment.
